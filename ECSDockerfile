# Render source-owned public configuration in a credential-free build stage.
FROM ubuntu:noble@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517 AS render-base
RUN apt-get update && apt-get install -y --no-install-recommends perl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY src ./src
COPY buildimage.sh ./buildimage.sh
COPY deploy/public-build.sh ./public-build.sh
FROM render-base AS render-dev
RUN bash ./public-build.sh dev

FROM render-base AS render-prod
RUN bash ./public-build.sh prod

FROM ubuntu:noble@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517 AS runtime-base

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        nginx curl \
    && rm -rf /var/lib/apt/lists/*

RUN rm -rf /var/log/nginx/*.log && rm -rf /etc/nginx/nginx.conf && rm -rf /etc/nginx/sites-enabled && rm -rf /etc/nginx/includes && rm -rf /data/nginx/dist && rm -rf /data/nginx/*
RUN ln -s /dev/stderr /var/log/nginx/error.log
RUN mkdir -p /data/nginxconf
RUN mkdir -p /home/apps/nginx/app
RUN mkdir -p /usr/share/nginx/html/customerrorpage && chown -Rf www-data:www-data /usr/share/nginx/html/customerrorpage

COPY rund /data/nginxconf/
COPY healthcheck.html /home/apps/nginx/app/healthcheck.html

RUN ln -s /data/nginxconf/dist/nginx.conf /etc/nginx/nginx.conf
RUN ln -s /data/nginxconf/dist/limits.conf /etc/nginx/limits.conf
RUN ln -s /data/nginxconf/dist/sites-enabled /etc/nginx/sites-enabled
RUN ln -s /data/nginxconf/dist/includes /etc/nginx/includes
RUN ln -s /data/nginxconf/dist/customerrorpage /usr/share/nginx/html/customerrorpage
RUN ln -s /data/nginxconf/dist/security_headers.conf /etc/nginx/security_headers.conf

RUN chown -Rf www-data:www-data /data/nginxconf

WORKDIR /data/nginxconf

LABEL app="nginx-supply" \
      version="1.0"

USER www-data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl --fail --silent http://127.0.0.1:8000/healthcheck.html >/dev/null || exit 1
CMD ["./rund"]

FROM runtime-base AS dev
COPY --from=render-dev --chown=www-data:www-data /source/dist /data/nginxconf/dist

FROM runtime-base AS prod
COPY --from=render-prod --chown=www-data:www-data /source/dist /data/nginxconf/dist
