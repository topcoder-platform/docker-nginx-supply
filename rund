#!/usr/bin/env bash
set -euo pipefail

if [[ "${PROVIDER:-}" == local ]]; then
	printf '%s\n' '8.8.8.8 dns01.topcoder.com' >> /etc/hosts
fi

for runtime_directory in \
	/tmp/nginx \
	/tmp/nginx/cache \
	/tmp/nginx/client-body \
	/tmp/nginx/fastcgi \
	/tmp/nginx/proxy \
	/tmp/nginx/scgi \
	/tmp/nginx/uwsgi
do
	install --directory --mode=0750 --owner=www-data --group=www-data \
		"${runtime_directory}"
done

nginx -t
exec nginx
