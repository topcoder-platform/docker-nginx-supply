#!/usr/bin/env bash
set -euo pipefail
./build

ln -sfn /data/nginx/dist/nginx.conf /etc/nginx/nginx.conf
ln -sfn /data/nginx/dist/limits.conf /etc/nginx/limits.conf
ln -sfn /data/nginx/dist/sites-enabled /etc/nginx/sites-enabled
ln -sfn /data/nginx/dist/includes /etc/nginx/includes
ln -sfn /data/nginx/dist/security_headers.conf /etc/nginx/security_headers.conf
ln -sfn /data/nginx/dist/customerrorpage /usr/share/nginx/html/customerrorpage

chown -R www-data:www-data /data/nginx/dist
exec ./rund
